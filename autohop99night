-- ====== Services ======
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- ====== PlaceId Config ======
local PlaceIdCheck = 79546208627805
local TargetPlaceId = 126509999114328
local HopDelay = 1

-- ====== Simple Server Tracking ======
local currentServerId = game.JobId or ""
local previousServers = {} -- Just keep a small list of recent servers
local maxRememberServers = 20 -- Only remember last 20 servers
local isHopping = false

-- ====== Simple Server Selection ======
local function getFreshServers(placeId)
    local servers = {}
    local success, response = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/"..placeId.."/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true")
    end)
    
    if success then
        local data = HttpService:JSONDecode(response)
        if data and data.data then
            for _, v in pairs(data.data) do
                if type(v) == "table" and v.playing < v.maxPlayers and v.id then
                    local serverId = v.id
                    
                    -- Skip current server and recent servers
                    local isRecent = false
                    if serverId == currentServerId then
                        isRecent = true
                    else
                        for _, recentServer in pairs(previousServers) do
                            if serverId == recentServer then
                                isRecent = true
                                break
                            end
                        end
                    end
                    
                    if not isRecent then
                        table.insert(servers, serverId)
                        if #servers >= 15 then break end
                    end
                end
            end
        end
    end
    
    print("📊 Fresh servers found:", #servers)
    return servers
end

-- ====== Add to recent servers ======
local function rememberServer(serverId)
    if not serverId or serverId == "" then return end
    
    -- Add to front of list
    table.insert(previousServers, 1, serverId)
    
    -- Keep only recent servers
    if #previousServers > maxRememberServers then
        table.remove(previousServers, #previousServers)
    end
    
    print("🧠 Remembered server:", serverId, "(Total:", #previousServers .. ")")
end

-- ====== Script 1: Server Hop ======
local function script1()
    while true do
        if game.PlaceId == PlaceIdCheck then
            TeleportService:Teleport(TargetPlaceId, LocalPlayer)
        end
        wait(HopDelay)
    end
end

-- ====== Script 2: Auto Farm + Smart Hop ======
local function script2()
    print("🚀 Starting Simple Auto Farm...")
    
    -- Remember current server
    if currentServerId ~= "" then
        rememberServer(currentServerId)
        print("✅ Current server:", currentServerId)
    end
    
    -- ====== Player & Character ======
    local player = Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

    -- ====== Diamond GUI ======
    local guiCount = player.PlayerGui:WaitForChild("Interface"):WaitForChild("DiamondCount"):WaitForChild("Count")

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "DiamondDisplay"
    screenGui.Parent = player.PlayerGui

    local diamondLabel = Instance.new("TextLabel")
    diamondLabel.Size = UDim2.new(0,200,0,50)
    diamondLabel.Position = UDim2.new(0.5,-100,0.5,-25)
    diamondLabel.BackgroundTransparency = 0.5
    diamondLabel.BackgroundColor3 = Color3.fromRGB(0,0,0)
    diamondLabel.TextColor3 = Color3.fromRGB(0,255,0)
    diamondLabel.TextScaled = true
    diamondLabel.Font = Enum.Font.GothamBold
    diamondLabel.Text = "Diamonds: 0"
    diamondLabel.Parent = screenGui

    -- ====== Auto Collect & Chest ======
    local openedChests = {}
    local autoCollectEnabled = true
    local autoChestEnabled = true

    local function teleportTo(position)
        if humanoidRootPart then
            humanoidRootPart.CFrame = CFrame.new(position)
        end
    end

    local function collectDiamondRemote(diamond)
        pcall(function()
            if ReplicatedStorage:FindFirstChild("RemoteEvents") then
                local remotes = ReplicatedStorage.RemoteEvents
                if remotes:FindFirstChild("DiamondsClaimed") then
                    remotes.DiamondsClaimed:FireServer(diamond)
                end
                if remotes:FindFirstChild("RequestTakeDiamonds") then
                    remotes.RequestTakeDiamonds:FireServer(diamond)
                end
            end
        end)
    end

    local function collectDiamondTeleport(diamond)
        pcall(function()
            if diamond:FindFirstChild("Position") then
                teleportTo(diamond.Position.Value or diamond.Position)
                if diamond:FindFirstChild("ClickDetector") then
                    diamond.ClickDetector.MouseClick:Fire()
                elseif diamond:FindFirstChild("ProximityPrompt") then
                    diamond.ProximityPrompt.Triggered:Fire()
                end
            end
        end)
    end

    local function openChest(chest)
        local id = tostring(chest)
        if openedChests[id] then return false end
        local success = pcall(function()
            if ReplicatedStorage:FindFirstChild("RemoteEvents") then
                local remotes = ReplicatedStorage.RemoteEvents
                if remotes:FindFirstChild("RequestOpenItemChest") then
                    remotes.RequestOpenItemChest:FireServer(chest)
                    openedChests[id] = true
                    return true
                end
            end
            if chest:FindFirstChild("Position") then
                teleportTo(chest.Position)
                if chest:FindFirstChild("ProximityPrompt") then
                    chest.ProximityPrompt.Triggered:Fire()
                    openedChests[id] = true
                elseif chest:FindFirstChild("ClickDetector") then
                    chest.ClickDetector.MouseClick:Fire()
                    openedChests[id] = true
                end
            end
        end)
        return success
    end

    -- Check resources availability
    local function checkResources()
        local diamondCount = 0
        local chestCount = 0
        
        for _, item in pairs(workspace.Items:GetChildren()) do
            if item.Name == "Diamond" or item:FindFirstChild("Diamond") then
                diamondCount = diamondCount + 1
            elseif string.find(item.Name:lower(), "chest") then
                chestCount = chestCount + 1
            end
        end
        
        return diamondCount, chestCount
    end

    local function autoOpenChests()
        if not autoChestEnabled then return end
        local chests = {}
        for _, item in pairs(workspace.Items:GetChildren()) do
            if string.find(item.Name:lower(), "chest") then
                table.insert(chests, item)
            end
        end
        for _, chest in ipairs(chests) do
            openChest(chest)
        end
    end

    local function autoCollectDiamonds()
        if not autoCollectEnabled then return end
        local diamonds = {}
        for _, item in pairs(workspace.Items:GetChildren()) do
            if item.Name == "Diamond" or item:FindFirstChild("Diamond") then
                table.insert(diamonds, item)
            end
        end
        for _, diamond in ipairs(diamonds) do
            collectDiamondRemote(diamond)
            collectDiamondTeleport(diamond)
        end
    end

    -- Update GUI
    spawn(function()
        while true do
            if guiCount and guiCount:IsA("TextLabel") then
                diamondLabel.Text = "Diamonds: "..(guiCount.Text or "0")
            end
            wait(0.2)
        end
    end)

    -- Main Automation
    spawn(function()
        while true do
            autoOpenChests()
            autoCollectDiamonds()
            wait(0.2)
        end
    end)

    -- ====== Flying over fire ======
    local function startFlying(char)
        local hrp = char:WaitForChild("HumanoidRootPart")
        local hoverHeight = 90
        local bp = Instance.new("BodyPosition")
        bp.MaxForce = Vector3.new(1e5,1e5,1e5)
        bp.Position = workspace.Map.Campground.MainFire.Center.Position + Vector3.new(0, hoverHeight, 0)
        bp.Parent = hrp

        RunService.RenderStepped:Connect(function()
            if hrp.Parent then
                bp.Position = workspace.Map.Campground.MainFire.Center.Position + Vector3.new(0, hoverHeight, 0)
            end
        end)
    end

    if player.Character then
        startFlying(player.Character)
    end
    player.CharacterAdded:Connect(startFlying)

    -- ====== Simple Server Hop ======
    local function simpleServerHop()
        if isHopping then return end
        isHopping = true
        
        -- Remember current server before leaving
        rememberServer(currentServerId)
        
        print("🚀 Starting simple server hop...")
        
        spawn(function()
            while isHopping do
                local servers = getFreshServers(game.PlaceId)
                if #servers > 0 then
                    for _, serverId in ipairs(servers) do
                        if not isHopping then break end
                        
                        print("⚡ Hopping to:", serverId)
                        pcall(function()
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, player)
                        end)
                        
                        wait(0.1) -- Fast hop
                    end
                else
                    print("❌ No fresh servers, trying random")
                    pcall(function()
                        TeleportService:Teleport(game.PlaceId, player)
                    end)
                end
                wait(0.5) -- Brief pause between attempts
            end
        end)
    end

    -- Smart hop conditions with instant chest check
    spawn(function()
        local checkTimer = 0
        local maxWaitTime = 6 -- 6 seconds per server
        local initialCheckDone = false
        
        while true do
            wait(1)
            checkTimer = checkTimer + 1
            
            local diamonds, chests = checkResources()
            
            local shouldHop = false
            local reason = ""
            
            -- Instant check for chests after 2 seconds
            if not initialCheckDone and checkTimer >= 2 then
                initialCheckDone = true
                if chests == 0 then
                    shouldHop = true
                    reason = "no_chests_found_instant"
                    print("💨 No chests detected - instant hop!")
                end
            end
            
            -- Regular checks
            if not shouldHop then
                if checkTimer >= maxWaitTime then
                    shouldHop = true
                    reason = "max_time_reached"
                elseif checkTimer >= 5 and diamonds == 0 and chests == 0 then
                    shouldHop = true
                    reason = "no_resources_found"
                end
            end
            
            if shouldHop then
                print("🎯 Hop triggered: " .. reason)
                checkTimer = 0
                simpleServerHop()
                break
            end
        end
    end)
end

-- ====== Run Script ======
if game.PlaceId == PlaceIdCheck then
    script1()
elseif game.PlaceId == TargetPlaceId then
    script2()
end

-- ====== Simple Manual Commands ======
_G.hopNow = function()
    if game.PlaceId == TargetPlaceId then
        isHopping = false
        wait(0.1)
        
        rememberServer(currentServerId)
        
        local servers = getFreshServers(game.PlaceId)
        if #servers > 0 then
            local serverId = servers[1]
            print("🎯 Manual hopping to:", serverId)
            TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, LocalPlayer)
        else
            print("❌ No suitable servers found")
        end
    end
end

_G.showServers = function()
    print("=== SIMPLE SERVER TRACKING ===")
    print("Current server:", currentServerId)
    print("Remembered servers:", #previousServers)
    
    for i, serverId in ipairs(previousServers) do
        if i <= 10 then -- Show first 10
            print("  " .. i .. ". " .. serverId)
        end
    end
    
    if #previousServers > 10 then
        print("  ... and " .. (#previousServers - 10) .. " more")
    end
end

_G.clearServers = function()
    previousServers = {}
    print("✅ Server memory cleared!")
end

_G.forgetCurrent = function()
    -- Remove current server from memory so we can revisit
    for i, serverId in ipairs(previousServers) do
        if serverId == currentServerId then
            table.remove(previousServers, i)
            print("🧠 Forgot current server:", currentServerId)
            return
        end
    end
    print("❌ Current server not in memory")
end

print("Simple Auto Farm Diamonds - No Complex Blacklist ✅")
print("Commands: _G.hopNow(), _G.showServers(), _G.clearServers(), _G.forgetCurrent()")
