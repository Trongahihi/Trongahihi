-- ====== Enhanced Blacklist System ======
local NotSameSV_useid = "NotSameSV_" .. LocalPlayer.UserId .. ".json"
local ServerHistory_useid = "ServerHistory_" .. LocalPlayer.UserId .. ".json"
local blacklistedServers = {}
local serverHistory = {} -- Method 2: History tracking
local isHopping = false
