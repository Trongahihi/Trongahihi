print("=== THÔNG TIN DEBUG ===")
print("UserID: " .. PlayerUserID)
print("Server hiện tại: " .. CurrentServerID)
print("File sử dụng: " .. FILENAME)
print("Place ID: " .. PlaceID)

-- Khởi động script
Teleport()
