-- ====== Services ======
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- ====== PlaceId Config ======
local PlaceIdCheck = 79546208627805
local TargetPlaceId = 126509999114328
local HopDelay = 1

-- ====== Simple Server Tracking ======
local currentServerId = game.JobId or ""
local previousServers = {} 
local maxRememberServers = 20 
local isHopping = false

-- ====== Simple Server Selection ======
local function getFreshServers(placeId)
    local servers = {}
    local success, response = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/"..placeId.."/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true")
    end)
    
    if success then
        local data = HttpService:JSONDecode(response)
        if data and data.data then
            for _, v in pairs(data.data) do
                if type(v) == "table" and v.playing < v.maxPlayers and v.id then
                    local serverId = v.id
                    
                    local isRecent = false
                    if serverId == currentServerId then
                        isRecent = true
                    else
                        for _, recentServer in pairs(previousServers) do
                            if serverId == recentServer then
                                isRecent = true
                                break
                            end
                        end
                    end
                    
                    if not isRecent then
                        table.insert(servers, serverId)
                        if #servers >= 15 then break end
                    end
                end
            end
        end
    end
    
    print("📊 Fresh servers found:", #servers)
    return servers
end

-- ====== Add to recent servers ======
local function rememberServer(serverId)
    if not serverId or serverId == "" then return end
    
    table.insert(previousServers, 1, serverId)
    
    if #previousServers > maxRememberServers then
        table.remove(previousServers, #previousServers)
    end
    
    print("🧠 Remembered server:", serverId, "(Total:", #previousServers .. ")")
end

-- ====== Script 1: Server Hop ======
local function script1()
    while true do
        if game.PlaceId == PlaceIdCheck then
            TeleportService:Teleport(TargetPlaceId, LocalPlayer)
        end
        wait(HopDelay)
    end
end

-- ====== Script 2: Auto Farm + Smart Hop ======
local function script2()
    print("🚀 Starting Improved Auto Farm...")
    
    if currentServerId ~= "" then
        rememberServer(currentServerId)
        print("✅ Current server:", currentServerId)
    end

    -- ====== Player & Character ======
    local player = Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:WaitForChild("Humanoid")

    -- ====== Diamond GUI ======
    local guiCount = player.PlayerGui:WaitForChild("Interface"):WaitForChild("DiamondCount"):WaitForChild("Count")

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "DiamondDisplay"
    screenGui.Parent = player.PlayerGui

    local diamondLabel = Instance.new("TextLabel")
    diamondLabel.Size = UDim2.new(0,300,0,80)
    diamondLabel.Position = UDim2.new(0.5,-150,0.1,0)
    diamondLabel.BackgroundTransparency = 0.3
    diamondLabel.BackgroundColor3 = Color3.fromRGB(0,0,0)
    diamondLabel.TextColor3 = Color3.fromRGB(0,255,255)
    diamondLabel.TextScaled = true
    diamondLabel.Font = Enum.Font.GothamBold
    diamondLabel.Text = "💎 Diamonds: 0 | Status: Starting..."
    diamondLabel.Parent = screenGui

    -- ====== Player Death Detection ======
    local function isPlayerDead()
        if not player.Character then return true end
        if not player.Character:FindFirstChild("Humanoid") then return true end
        if player.Character.Humanoid.Health <= 0 then return true end
        if not player.Character:FindFirstChild("HumanoidRootPart") then return true end
        return false
    end

    -- ====== Enhanced Auto Collect & Chest ======
    local openedChests = {}
    local collectedDiamonds = {}
    local autoCollectEnabled = true
    local autoChestEnabled = true
    local lastCollectionTime = tick()

    -- SUPER FAST COLLECTION - Multiple methods simultaneously
    local function superFastCollectDiamond(diamond)
        local diamondId = tostring(diamond)
        if collectedDiamonds[diamondId] then return end
        
        pcall(function()
            -- Method 1: Remote Events
            if ReplicatedStorage:FindFirstChild("RemoteEvents") then
                local remotes = ReplicatedStorage.RemoteEvents
                if remotes:FindFirstChild("DiamondsClaimed") then
                    remotes.DiamondsClaimed:FireServer(diamond)
                end
                if remotes:FindFirstChild("RequestTakeDiamonds") then
                    remotes.RequestTakeDiamonds:FireServer(diamond)
                end
                if remotes:FindFirstChild("ClaimDiamond") then
                    remotes.ClaimDiamond:FireServer(diamond)
                end
            end
            
            -- Method 2: Click/Touch Detection
            if diamond:FindFirstChild("ClickDetector") then
                diamond.ClickDetector.MouseClick:Fire()
            end
            if diamond:FindFirstChild("ProximityPrompt") then
                diamond.ProximityPrompt.Triggered:Fire()
            end
            
            -- Method 3: Try common remote names
            pcall(function()
                game.ReplicatedStorage.Remotes.CollectDiamond:FireServer(diamond)
            end)
            pcall(function()
                game.ReplicatedStorage.Events.TakeDiamond:FireServer(diamond)
            end)
            
            collectedDiamonds[diamondId] = true
            lastCollectionTime = tick()
        end)
    end

    local function superFastOpenChest(chest)
        local chestId = tostring(chest)
        if openedChests[chestId] then return end
        
        pcall(function()
            -- Method 1: Remote Events
            if ReplicatedStorage:FindFirstChild("RemoteEvents") then
                local remotes = ReplicatedStorage.RemoteEvents
                if remotes:FindFirstChild("RequestOpenItemChest") then
                    remotes.RequestOpenItemChest:FireServer(chest)
                end
                if remotes:FindFirstChild("OpenChest") then
                    remotes.OpenChest:FireServer(chest)
                end
            end
            
            -- Method 2: Click/Touch Detection
            if chest:FindFirstChild("ClickDetector") then
                chest.ClickDetector.MouseClick:Fire()
            end
            if chest:FindFirstChild("ProximityPrompt") then
                chest.ProximityPrompt.Triggered:Fire()
            end
            
            -- Method 3: Try common remote names
            pcall(function()
                game.ReplicatedStorage.Remotes.OpenChest:FireServer(chest)
            end)
            pcall(function()
                game.ReplicatedStorage.Events.ChestOpen:FireServer(chest)
            end)
            
            openedChests[chestId] = true
        end)
    end

    -- Check resources availability
    local function checkResources()
        local diamondCount = 0
        local chestCount = 0
        
        if workspace:FindFirstChild("Items") then
            for _, item in pairs(workspace.Items:GetChildren()) do
                if item.Name == "Diamond" or item:FindFirstChild("Diamond") or string.find(item.Name:lower(), "diamond") then
                    diamondCount = diamondCount + 1
                elseif string.find(item.Name:lower(), "chest") then
                    chestCount = chestCount + 1
                end
            end
        end
        
        return diamondCount, chestCount
    end

    -- ULTRA FAST COLLECTION LOOP - 10 times per second
    local function ultraFastAutoCollection()
        spawn(function()
            while autoCollectEnabled and not isPlayerDead() do
                if workspace:FindFirstChild("Items") then
                    -- Collect everything in one sweep
                    for _, item in pairs(workspace.Items:GetChildren()) do
                        -- Diamonds
                        if item.Name == "Diamond" or item:FindFirstChild("Diamond") or string.find(item.Name:lower(), "diamond") then
                            superFastCollectDiamond(item)
                        end
                        
                        -- Chests
                        if string.find(item.Name:lower(), "chest") then
                            superFastOpenChest(item)
                        end
                    end
                end
                wait(0.1) -- 10 times per second
            end
        end)
    end

    -- Update GUI with more info
    spawn(function()
        while true do
            local diamonds, chests = checkResources()
            local status = "Farming"
            
            if isPlayerDead() then
                status = "💀 DEAD - HOPPING!"
            elseif diamonds == 0 and chests == 0 then
                status = "Empty Server"
            elseif tick() - lastCollectionTime < 2 then
                status = "⚡ Collecting"
            end
            
            if guiCount and guiCount:IsA("TextLabel") then
                diamondLabel.Text = string.format("💎 Diamonds: %s | 💰 D:%d C:%d | %s", 
                    guiCount.Text or "0", diamonds, chests, status)
            end
            wait(0.2)
        end
    end)

    -- Start ultra fast collection
    ultraFastAutoCollection()

    -- ====== Flying over fire ======
    local function startFlying(char)
        local hrp = char:WaitForChild("HumanoidRootPart")
        local hoverHeight = 90
        local bp = Instance.new("BodyPosition")
        bp.MaxForce = Vector3.new(1e5,1e5,1e5)
        bp.Position = workspace.Map.Campground.MainFire.Center.Position + Vector3.new(0, hoverHeight, 0)
        bp.Parent = hrp

        RunService.RenderStepped:Connect(function()
            if hrp.Parent then
                bp.Position = workspace.Map.Campground.MainFire.Center.Position + Vector3.new(0, hoverHeight, 0)
            end
        end)
    end

    if player.Character then
        startFlying(player.Character)
    end
    player.CharacterAdded:Connect(startFlying)

    -- ====== Character Respawn Handler ======
    player.CharacterAdded:Connect(function(newChar)
        character = newChar
        humanoidRootPart = newChar:WaitForChild("HumanoidRootPart")
        humanoid = newChar:WaitForChild("Humanoid")
        
        -- Clear collection memory on respawn
        collectedDiamonds = {}
        openedChests = {}
        
        -- Restart flying
        startFlying(newChar)
        
        -- Restart collection
        ultraFastAutoCollection()
        
        print("🔄 Character respawned, restarting systems...")
    end)

    -- ====== Simple Server Hop ======
    local function simpleServerHop(reason)
        if isHopping then return end
        isHopping = true
        
        rememberServer(currentServerId)
        print("🚀 Server hopping - Reason:", reason)
        
        spawn(function()
            while isHopping do
                local servers = getFreshServers(game.PlaceId)
                if #servers > 0 then
                    for _, serverId in ipairs(servers) do
                        if not isHopping then break end
                        
                        print("⚡ Hopping to:", serverId)
                        pcall(function()
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, player)
                        end)
                        
                        wait(0.1)
                    end
                else
                    print("❌ No fresh servers, trying random")
                    pcall(function()
                        TeleportService:Teleport(game.PlaceId, player)
                    end)
                end
                wait(0.5)
            end
        end)
    end

    -- IMPROVED Smart hop conditions with death detection
    spawn(function()
        local checkTimer = 0
        local maxWaitTime = 3 -- Reduced to 3 seconds per server for faster farming
        local initialCheckDone = false
        
        while true do
            wait(0.5) -- Check twice per second
            checkTimer = checkTimer + 0.5
            
            -- INSTANT HOP ON DEATH
            if isPlayerDead() then
                print("💀 Player died - instant hop!")
                simpleServerHop("player_death")
                break
            end
            
            local diamonds, chests = checkResources()
            
            local shouldHop = false
            local reason = ""
            
            -- Instant check for resources after 1 second
            if not initialCheckDone and checkTimer >= 1 then
                initialCheckDone = true
                if chests == 0 and diamonds == 0 then
                    shouldHop = true
                    reason = "no_resources_instant"
                    print("💨 No resources detected - instant hop!")
                end
            end
            
            -- 2-second guarantee: if no collection happened in 2 seconds, hop
            if not shouldHop and checkTimer >= 2 then
                if tick() - lastCollectionTime > 2 then
                    shouldHop = true
                    reason = "no_collection_2s"
                    print("⏰ No collection in 2 seconds - hopping!")
                end
            end
            
            -- Regular checks
            if not shouldHop then
                if checkTimer >= maxWaitTime then
                    shouldHop = true
                    reason = "max_time_reached"
                elseif checkTimer >= 2 and diamonds == 0 and chests == 0 then
                    shouldHop = true
                    reason = "no_resources_found"
                end
            end
            
            if shouldHop then
                print("🎯 Hop triggered: " .. reason)
                -- Reset GUI timer when hopping
                spawn(function()
                    statusLabel.Text = "🚀 HOPPING TO NEW SERVER..."
                    statusLabel.TextColor3 = Color3.fromRGB(255,0,255)
                    timerLabel.Text = "⏱️ Hopping..."
                    timerLabel.TextColor3 = Color3.fromRGB(255,0,255)
                end)
                checkTimer = 0
                simpleServerHop(reason)
                break
            end
        end
    end)
end

-- ====== Run Script ======
if game.PlaceId == PlaceIdCheck then
    script1()
elseif game.PlaceId == TargetPlaceId then
    script2()
end

-- ====== Enhanced Manual Commands ======
_G.hopNow = function()
    if game.PlaceId == TargetPlaceId then
        isHopping = false
        wait(0.1)
        
        rememberServer(currentServerId)
        
        local servers = getFreshServers(game.PlaceId)
        if #servers > 0 then
            local serverId = servers[1]
            print("🎯 Manual hopping to:", serverId)
            TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, LocalPlayer)
        else
            print("❌ No suitable servers found")
        end
    end
end

_G.showServers = function()
    print("=== SERVER TRACKING ===")
    print("Current server:", currentServerId)
    print("Remembered servers:", #previousServers)
    
    for i, serverId in ipairs(previousServers) do
        if i <= 10 then
            print("  " .. i .. ". " .. serverId)
        end
    end
    
    if #previousServers > 10 then
        print("  ... and " .. (#previousServers - 10) .. " more")
    end
end

_G.clearServers = function()
    previousServers = {}
    print("✅ Server memory cleared!")
end

_G.forgetCurrent = function()
    for i, serverId in ipairs(previousServers) do
        if serverId == currentServerId then
            table.remove(previousServers, i)
            print("🧠 Forgot current server:", currentServerId)
            return
        end
    end
    print("❌ Current server not in memory")
end

_G.checkStatus = function()
    local player = Players.LocalPlayer
    print("=== FARM STATUS ===")
    print("Player alive:", not isPlayerDead())
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        print("Health:", player.Character.Humanoid.Health)
    end
    local d, c = checkResources()
    print("Diamonds available:", d)
    print("Chests available:", c)
    print("Last collection:", tick() - lastCollectionTime, "seconds ago")
end

print("🚀 IMPROVED Auto Farm Diamonds - Ultra Fast Collection ✅")
print("💎 2-Second Collection Guarantee | 💀 Instant Death Hop")
print("📋 Commands: _G.hopNow(), _G.showServers(), _G.clearServers(), _G.forgetCurrent(), _G.checkStatus()")
