local PlaceID = game.PlaceId
local AllIDs = {}
local foundAnything = ""
local actualHour = os.date("!*t").hour

-- Tạo tên file dựa trên UserID của người chơi
local PlayerUserID = game.Players.LocalPlayer.UserId
local FILENAME = "Not" .. PlayerUserID .. "SameServer.json"

-- Lấy server hiện tại
local CurrentServerID = tostring(game.JobId)

-- Tự động xóa file mỗi 20 phút
local FILE_CLEANUP_INTERVAL = 20 * 60 -- 20 phút tính bằng giây
local lastCleanupTime = tick()

local function shouldCleanupFile()
    return tick() - lastCleanupTime >= FILE_CLEANUP_INTERVAL
end

local function cleanupFile()
    pcall(function()
        if isfile(FILENAME) then
            delfile(FILENAME)
            print("🗑️ Đã xóa file " .. FILENAME .. " sau 20 phút")
        end
        AllIDs = {actualHour}
        lastCleanupTime = tick()
        print("🔄 Đã reset danh sách servers cho UserID: " .. PlayerUserID)
    end)
end

-- Đọc file hoặc tạo mới
local success, err = pcall(function()
    if isfile(FILENAME) then
        AllIDs = game:GetService('HttpService'):JSONDecode(readfile(FILENAME))
        print("📂 Đã đọc file " .. FILENAME .. " thành công")
    else
        error("File không tồn tại")
    end
end)

if not success or not AllIDs then
    AllIDs = {actualHour}
    writefile(FILENAME, game:GetService('HttpService'):JSONEncode(AllIDs))
    print("📁 Tạo file " .. FILENAME .. " mới cho UserID: " .. PlayerUserID)
end

-- Hàm kiểm tra server hiện tại có trong danh sách đã vào không
local function isInUsedServer()
    for _, usedServerID in pairs(AllIDs) do
        if tostring(usedServerID) == CurrentServerID then
            return true
        end
    end
    return false
end

-- Hàm thêm server hiện tại vào danh sách đã sử dụng
local function addCurrentServerToUsed()
    if not isInUsedServer() then
        table.insert(AllIDs, CurrentServerID)
        writefile(FILENAME, game:GetService('HttpService'):JSONEncode(AllIDs))
        print("➕ Đã thêm server hiện tại vào danh sách đã sử dụng: " .. CurrentServerID)
    end
end

-- Hàm kiểm tra có nên teleport tới server này không
local function shouldTeleportToServer(ID)
    local serverID = tostring(ID)
    
    -- Không teleport tới server hiện tại
    if serverID == CurrentServerID then
        return false
    end
    
    -- Không teleport tới server đã từng vào
    for _, existingID in pairs(AllIDs) do
        if tostring(existingID) == serverID then
            return false
        end
    end
    
    return true
end

-- Teleport flag
local isTeleporting = false

local function teleportPlayer(PlaceID, ID)
    if isTeleporting then return end
    isTeleporting = true
    
    print("🚀 [UserID: " .. PlayerUserID .. "] Đang teleport đến server: " .. ID)
    
    pcall(function()
        game:GetService("TeleportService"):TeleportToPlaceInstance(PlaceID, ID, game.Players.LocalPlayer)
    end)
    
    wait(1) -- 1 giây cho teleport
    isTeleporting = false
end

-- Hàm tìm server mới để teleport
function findAndTeleport()
    -- Kiểm tra và xóa file nếu đã đủ 20 phút
    if shouldCleanupFile() then
        cleanupFile()
    end
    
    local Site
    if foundAnything == "" then
        Site = game.HttpService:JSONDecode(game:HttpGet('https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=Asc&limit=100'))
    else
        Site = game.HttpService:JSONDecode(game:HttpGet('https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=Asc&limit=100&cursor=' .. foundAnything))
    end
    
    if Site.nextPageCursor and Site.nextPageCursor ~= "null" then
        foundAnything = Site.nextPageCursor
    else
        foundAnything = ""
    end
    
    print("🔍 Tìm kiếm server mới trong " .. #Site.data .. " servers...")
    
    for _, v in pairs(Site.data) do
        local ID = tostring(v.id)
        
        if tonumber(v.maxPlayers) > tonumber(v.playing) then
            if shouldTeleportToServer(ID) then
                print("✅ Tìm thấy server phù hợp: " .. ID .. " (" .. v.playing .. "/" .. v.maxPlayers .. " người chơi)")
                teleportPlayer(PlaceID, ID)
                return true -- Đã tìm thấy và teleport
            end
        end
    end
    
    return false -- Không tìm thấy server phù hợp
end

-- Hàm chính để kiểm tra và auto hop
function autoServerHopper()
    print("=== AUTO SERVER HOPPER ===")
    print("UserID: " .. PlayerUserID)
    print("Server hiện tại: " .. CurrentServerID)
    print("File sử dụng: " .. FILENAME)
    print("Place ID: " .. PlaceID)
    
    -- Kiểm tra PlaceID đặc biệt - không hop nếu ở PlaceID này
    if tostring(PlaceID) == "79546208627805" then
        print("🚫 PHÁT HIỆN PLACE ID ĐỘC QUYỀN: " .. PlaceID)
        print("🔒 Server hopping đã bị VÔ HIỆU HÓA cho Place này")
        print("✅ Script sẽ chỉ theo dõi mà không thực hiện hop server")
        
        -- Chỉ theo dõi và log, không hop
        while true do
            wait(10) -- ⚡ Giảm từ 30s xuống 10s cho monitor mode
            CurrentServerID = tostring(game.JobId)
            addCurrentServerToUsed() -- Vẫn lưu server để tracking
            print("📊 [MONITOR MODE] Server hiện tại: " .. CurrentServerID .. " | Đã track " .. #AllIDs .. " servers")
        end
        return
    end
    
    -- Vòng lặp kiểm tra liên tục
    while true do
        wait(1) -- ⚡ Kiểm tra mỗi 1 giây để phản ứng siêu nhanh
        
        -- Cập nhật server ID hiện tại (có thể thay đổi sau khi teleport)
        CurrentServerID = tostring(game.JobId)
        
        -- Kiểm tra nếu đang ở server đã từng vào
        if isInUsedServer() then
            print("⚠️ Phát hiện đang ở server đã sử dụng: " .. CurrentServerID)
            print("🔄 Bắt đầu tìm server mới...")
            
            local attempts = 0
            local maxAttempts = 10
            
            while attempts < maxAttempts do
                local success = pcall(function()
                    return findAndTeleport()
                end)
                
                if success then
                    print("✅ Đã tìm thấy và teleport tới server mới")
                    -- QUAN TRỌNG: Thêm server cũ vào blacklist TRƯỚC KHI TELEPORT
                    if not isInUsedServer() then
                        table.insert(AllIDs, CurrentServerID)
                        writefile(FILENAME, game:GetService('HttpService'):JSONEncode(AllIDs))
                        print("🚫 Đã blacklist server cũ: " .. CurrentServerID)
                    end
                    wait(3) -- ⚡ Chờ 3 giây cho teleport hoàn thành (giảm từ 10s)
                    break
                else
                    attempts = attempts + 1
                    print("❌ Lần thử " .. attempts .. "/" .. maxAttempts .. " thất bại")
                    wait(1) -- ⚡ Giảm thời gian chờ từ 3s xuống 1s
                    
                    if attempts >= maxAttempts then
                        print("🛑 Đã thử tối đa, dừng tìm kiếm")
                        wait(30) -- ⚡ Giảm từ 60s xuống 30s để thử lại nhanh hơn
                    end
                end
            end
        else
            -- CHỈ THÔNG BÁO, KHÔNG THÊM VÀO BLACKLIST
            print("✅ Server hiện tại OK: " .. CurrentServerID .. " (chưa sử dụng)")
        end
        
        -- Hiển thị thống kê
        print("📊 Đã blacklist " .. #AllIDs .. " servers")
        print("⏰ Kiểm tra lại sau 1 giây... ⚡")
    end
end

-- Khởi động script
autoServerHopper()
