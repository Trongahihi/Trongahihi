local maxHistorySize = 200 -- Maximum servers to remember
local maxBlacklistAge = 3600 -- 1 hour in seconds
local fileCheckInterval = 60 -- Check file integrity every 60 seconds
local lastFileCheck = 0

-- ====== Enhanced Utility Functions ======
local function loadJSON(filename)
    local success, data = pcall(function()
        if not isfile(filename) then
            return "{}"
        end
        local fileData = readfile(filename)
        if fileData == "" or fileData == nil then
            return "{}"
        end
        return fileData
    end)
    
    if success and data then
        local decodeSuccess, decoded = pcall(function()
            return HttpService:JSONDecode(data)
        end)
        if decodeSuccess and type(decoded) == "table" then
            return decoded
        end
    end
    
    print("⚠️ Failed to load " .. filename .. ", creating new file")
    return {}
end

local function saveJSON(filename, data)
    local success = pcall(function()
        if type(data) ~= "table" then
            print("❌ Invalid data type for saving:", type(data))
            return
        end
        
        local encoded = HttpService:JSONEncode(data)
        if encoded and encoded ~= "" then
            writefile(filename, encoded)
            return true
        end
        return false
    end)
    
    if not success then
        print("❌ Failed to save " .. filename)
    end
    return success
end

local function validateFileIntegrity()
    local currentTime = tick()
    if currentTime - lastFileCheck < fileCheckInterval then
        return
    end
    
    lastFileCheck = currentTime
    
    -- Check blacklist file
    local testBlacklist = loadJSON(NotSameSV_useid)
    if type(testBlacklist) ~= "table" then
        print("🔧 Repairing blacklist file...")
        blacklistedServers = {}
        saveJSON(NotSameSV_useid, blacklistedServers)
    end
    
    -- Check history file
    local testHistory = loadJSON(ServerHistory_useid)
    if type(testHistory) ~= "table" then
        print("🔧 Repairing history file...")
        serverHistory = {}
        saveJSON(ServerHistory_useid, serverHistory)
    end
end

local function loadBlacklistData()
    validateFileIntegrity()
    blacklistedServers = loadJSON(NotSameSV_useid)
    serverHistory = loadJSON(ServerHistory_useid)
    
    -- Clean old entries on load
    cleanOldEntries()
    
    print("🚫 Loaded blacklisted servers:", #blacklistedServers)
    print("📚 Loaded server history:", #serverHistory)
end

local function saveBlacklistData()
    local success1 = saveJSON(NotSameSV_useid, blacklistedServers)
    local success2 = saveJSON(ServerHistory_useid, serverHistory)
    
    if not success1 or not success2 then
        print("⚠️ Some files failed to save properly")
    end
end

-- ====== Method 1: Traditional Blacklist ======
local function isServerBlacklisted(serverId)
    if not serverId or serverId == "" then return false end
    
    for _, serverData in pairs(blacklistedServers) do
        if serverData.serverId == serverId then
            return true
        end
    end
    return false
end

local function addToBlacklist(serverId, reason)
    if not serverId or serverId == "" then return end
    if isServerBlacklisted(serverId) then return end
    
    table.insert(blacklistedServers, {
        serverId = serverId,
        reason = reason,
        timestamp = os.time()
    })
    
    saveBlacklistData()
    print("🚫 Blacklisted server:", serverId, "(" .. reason .. ")")
end

-- ====== Method 2: Server History Tracking ======
local function addToHistory(serverId, reason)
    if not serverId or serverId == "" then return end
    
    -- Check if server already in history
    for i, serverData in ipairs(serverHistory) do
        if serverData.serverId == serverId then
            -- Update existing entry
            serverHistory[i].lastVisited = os.time()
            serverHistory[i].visitCount = (serverHistory[i].visitCount or 1) + 1
            serverHistory[i].lastReason = reason
            saveBlacklistData()
            return
        end
    end
    
    -- Add new entry
    table.insert(serverHistory, {
        serverId = serverId,
        firstVisited = os.time(),
        lastVisited = os.time(),
        visitCount = 1,
        lastReason = reason
    })
    
    -- Limit history size
    if #serverHistory > maxHistorySize then
        table.remove(serverHistory, 1) -- Remove oldest entry
    end
    
    saveBlacklistData()
    print("📚 Added to history:", serverId, "(" .. reason .. ")")
end

local function isServerInHistory(serverId)
    if not serverId or serverId == "" then return false end
    
    for _, serverData in pairs(serverHistory) do
        if serverData.serverId == serverId then
            return true
        end
    end
    return false
end

-- ====== Enhanced Cleanup System ======
local function cleanOldEntries()
    local currentTime = os.time()
    local removedBlacklist = 0
    local removedHistory = 0
    
    -- Clean blacklist (remove entries older than maxBlacklistAge)
    for i = #blacklistedServers, 1, -1 do
        local serverData = blacklistedServers[i]
        if serverData.timestamp and (currentTime - serverData.timestamp) > maxBlacklistAge then
            table.remove(blacklistedServers, i)
            removedBlacklist = removedBlacklist + 1
        end
    end
    
    -- Clean history (keep only recent entries, but don't remove them too aggressively)
    if #serverHistory > maxHistorySize then
        -- Sort by last visited time and keep only the most recent ones
        table.sort(serverHistory, function(a, b)
            return (a.lastVisited or 0) > (b.lastVisited or 0)
        end)
        
        -- Remove oldest entries
        local toRemove = #serverHistory - maxHistorySize
        for i = 1, toRemove do
            table.remove(serverHistory, #serverHistory)
            removedHistory = removedHistory + 1
        end
    end
    
    if removedBlacklist > 0 or removedHistory > 0 then
        print("🧹 Cleaned " .. removedBlacklist .. " blacklist entries and " .. removedHistory .. " history entries")
        saveBlacklistData()
    end
end

local function autoCleanup()
    cleanupTimer = cleanupTimer + 1
    if cleanupTimer >= 600 then -- 10 minutes instead of 20
        print("🧹 Auto cleanup starting...")
        cleanOldEntries()
        cleanupTimer = 0
        print("✅ Auto cleanup completed!")
    end
end

local function forceCleanup()
    print("🧹 Force cleanup starting...")
    
    -- More aggressive cleanup
    local currentTime = os.time()
    local oldSize = #blacklistedServers
    
    -- Remove entries older than 30 minutes for force cleanup
    blacklistedServers = {}
    for _, serverData in pairs(blacklistedServers) do
        if serverData.timestamp and (currentTime - serverData.timestamp) < 1800 then -- 30 minutes
            table.insert(blacklistedServers, serverData)
        end
    end
    
    -- Keep only last 50 history entries
    if #serverHistory > 50 then
        table.sort(serverHistory, function(a, b)
            return (a.lastVisited or 0) > (b.lastVisited or 0)
        end)
        
        local newHistory = {}
        for i = 1, 50 do
            table.insert(newHistory, serverHistory[i])
        end
        serverHistory = newHistory
    end
    
    saveBlacklistData()
    cleanupTimer = 0
    
    print("✅ Force cleanup completed! Removed " .. (oldSize - #blacklistedServers) .. " blacklist entries")
end

-- ====== Enhanced Server Selection ======
local function getFreshServers(placeId)
    local servers = {}
    local attempts = 0
    local maxAttempts = 3
    
    while #servers < 10 and attempts < maxAttempts do
        attempts = attempts + 1
        
        local success, response = pcall(function()
            return game:HttpGet("https://games.roblox.com/v1/games/"..placeId.."/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true")
        end)
        
        if success then
            local decodeSuccess, data = pcall(function()
                return HttpService:JSONDecode(response)
            end)
            
            if decodeSuccess and data and data.data then
                for _, v in pairs(data.data) do
                    if type(v) == "table" and v.playing < v.maxPlayers and v.id then
                        local serverId = v.id
                        
                        -- Method 1: Check blacklist
                        -- Method 2: Check history (avoid recently visited servers)
                        if not isServerBlacklisted(serverId) and not isServerInHistory(serverId) then
                            table.insert(servers, serverId)
                            if #servers >= 15 then break end -- Get more servers
                        end
                    end
                end
            end
        end
        
        wait(0.5) -- Brief delay between API calls
    end
    
    print("📊 Fresh servers available (both methods):", #servers)
    
    -- If no servers found with both methods, try just blacklist method
    if #servers == 0 then
        print("⚠️ No servers found with both methods, trying blacklist only...")
        
        local success, response = pcall(function()
            return game:HttpGet("https://games.roblox.com/v1/games/"..placeId.."/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true")
        end)
        
        if success then
            local decodeSuccess, data = pcall(function()
                return HttpService:JSONDecode(response)
            end)
            
            if decodeSuccess and data and data.data then
                for _, v in pairs(data.data) do
                    if type(v) == "table" and v.playing < v.maxPlayers and v.id then
                        local serverId = v.id
                        if not isServerBlacklisted(serverId) then
                            table.insert(servers, serverId)
                            if #servers >= 5 then break end
                        end
                    end
                end
            end
        end
        
        print("📊 Servers available (blacklist only):", #servers)
    end
    
    return servers
end

