local plr = game.Players.LocalPlayer
local gui = plr.PlayerGui:WaitForChild("Interface"):WaitForChild("DiamondCount"):WaitForChild("Count")

local kickThreshold = getgenv().KickThreshold or 500

local function checkDiamondAndLeave()
    local diamondCount = tonumber(gui.Text) or 0
    if diamondCount >= kickThreshold then
        game:Shutdown()
    end
end

-- Delay 10s trước khi kết nối signal và vòng lặp
task.delay(10, function()
    -- Check lần đầu
    checkDiamondAndLeave()

    -- Khi diamond thay đổi text
    gui:GetPropertyChangedSignal("Text"):Connect(checkDiamondAndLeave)

    -- Check mỗi 5s
    task.spawn(function()
        while plr.Parent do
            task.wait(5)
            checkDiamondAndLeave()
        end
    end)
end)
