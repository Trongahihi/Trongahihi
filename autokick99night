local plr = game.Players.LocalPlayer
local gui = plr.PlayerGui:WaitForChild("Interface"):WaitForChild("DiamondCount"):WaitForChild("Count")
local kickThreshold = getgenv().KickThreshold or 500
local TeleportService = game:GetService("TeleportService")

-- PlaceId lobby
local lobbyPlaceId = 79546208627805

-- Hàm rejoin hiện tại (rejoin lại place hiện tại)
local function rejoin()
    local success, err = pcall(function()
        TeleportService:Teleport(game.PlaceId, plr)
    end)
    if not success then
        warn("[AUTO REJOIN] Lỗi rejoin:", err)
        task.delay(1, rejoin)
    end
end

-- Hàm teleport về lobby khi chết
local function teleportToLobby()
    local success, err = pcall(function()
        TeleportService:Teleport(lobbyPlaceId, plr)
    end)
    if not success then
        warn("[AUTO TELEPORT] Lỗi teleport lobby:", err)
        task.delay(1, teleportToLobby)
    end
end

-- Detect diamond để rejoin
local function checkDiamondAndRejoin()
    local diamondCount = tonumber(gui.Text) or 0
    if diamondCount >= kickThreshold then
        rejoin()
    end
end

-- Detect chết để teleport lobby
local function setupDeathDetection(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if humanoid then
        humanoid.Died:Connect(function()
            print("[AUTO TELEPORT] Player chết → Teleport về lobby")
            teleportToLobby()
        end)
    end
end

-- Khi nhân vật spawn
plr.CharacterAdded:Connect(setupDeathDetection)
if plr.Character then
    setupDeathDetection(plr.Character)
end

-- Delay 1s trước khi kết nối signal và vòng lặp
task.delay(1, function()
    checkDiamondAndRejoin()
    
    -- Khi diamond thay đổi text
    gui:GetPropertyChangedSignal("Text"):Connect(checkDiamondAndRejoin)
    
    -- Check mỗi 5s
    task.spawn(function()
        while plr.Parent do
            task.wait(5)
            checkDiamondAndRejoin()
        end
    end)
    
    -- Auto rejoin mỗi 20 phút
    task.spawn(function()
        while plr.Parent do
            task.wait(1200) -- 20 phút
            print("[AUTO REJOIN] Tự động rejoin sau 20 phút")
            rejoin()
        end
    end)
end)
