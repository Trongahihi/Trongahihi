local plr = game.Players.LocalPlayer
local gui = plr.PlayerGui:WaitForChild("Interface"):WaitForChild("DiamondCount"):WaitForChild("Count")
local kickThreshold = getgenv().KickThreshold or 500
local TeleportService = game:GetService("TeleportService")

local function rejoin()
    local success, err = pcall(function()
        TeleportService:Teleport(game.PlaceId, plr)
    end)
    if not success then
        warn("[AUTO REJOIN] Lỗi rejoin:", err)
        -- Thử lại sau 1 giây nếu lỗi
        task.delay(1, rejoin)
    end
end

local function checkDiamondAndRejoin()
    local diamondCount = tonumber(gui.Text) or 0
    if diamondCount >= kickThreshold then
        rejoin()
    end
end

-- Delay 1s trước khi kết nối signal và vòng lặp
task.delay(1, function()
    -- Check lần đầu
    checkDiamondAndRejoin()
    
    -- Khi diamond thay đổi text
    gui:GetPropertyChangedSignal("Text"):Connect(checkDiamondAndRejoin)
    
    -- Check mỗi 5s
    task.spawn(function()
        while plr.Parent do
            task.wait(5)
            checkDiamondAndRejoin()
        end
    end)
    
    -- Auto rejoin mỗi 20 phút (1200 giây)
    task.spawn(function()
        while plr.Parent do
            task.wait(1200) -- 20 phút = 1200 giây
            print("[AUTO REJOIN] Tự động rejoin sau 20 phút")
            rejoin()
        end
    end)
end)
