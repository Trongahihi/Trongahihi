-- Simple Executor Check - Lặp lại mỗi 175 giây
-- Chỉ tạo file userid.main với nội dung "userid:main"

local plr = game.Players.LocalPlayer
local userId = tostring(plr.UserId)
local fileName = userId .. ".main"
local fileContent = userId .. ":main"

-- Function tạo file
local function createFile()
    local success = false
    
    -- Thử writefile
    if writefile then
        pcall(function()
            writefile(fileName, fileContent)
            success = true
            print("✅ [" .. os.date("%H:%M:%S") .. "] Đã tạo file: " .. fileContent)
        end)
    end
    
    -- Thử Synapse nếu writefile fail
    if not success and syn and syn.write_file then
        pcall(function()
            syn.write_file(fileName, fileContent)
            success = true
            print("✅ [" .. os.date("%H:%M:%S") .. "] Đã tạo file (Synapse): " .. fileContent)
        end)
    end
    
    if not success then
        print("❌ [" .. os.date("%H:%M:%S") .. "] Không thể tạo file - executor không support writefile")
    end
    
    return success
end

-- Tạo file lần đầu
print("🚀 Tạo file lần đầu...")
createFile()

-- Loop chính - lặp lại mỗi 175 giây
spawn(function()
    while true do
        wait(175) -- Chờ 175 giây
        createFile()
    end
end)

print("✅ Script đã khởi động - sẽ lặp lại mỗi 175 giây")
