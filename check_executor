-- Diamond Reader Script cho Shouko.dev Tool
-- Chỉ ghi số diamond vào file
local plr = game.Players.LocalPlayer
local RunService = game:GetService("RunService")

-- Chờ GUI load
local function waitForGUI()
    local success, gui = pcall(function()
        return plr.PlayerGui:WaitForChild("Interface"):WaitForChild("DiamondCount"):WaitForChild("Count")
    end)
    
    if success then
        return gui
    else
        warn("Không thể tìm thấy Diamond GUI!")
        return nil
    end
end

-- Đọc số kim cương từ GUI
local function getDiamondCount(gui)
    if gui and gui.Text then
        -- Loại bỏ ký tự không phải số (ví dụ: dấu phay, chữ K, M)
        local cleanText = string.gsub(gui.Text, "[^%d]", "")
        local diamondCount = tonumber(cleanText) or 0
        return diamondCount
    end
    return 0
end

-- Ghi chỉ số diamond vào file
local function saveDiamondToFile(userId, diamondCount)
    local fileName = userId .. ".main"
    local data = tostring(diamondCount) -- Chỉ ghi số diamond
    
    if writefile then
        writefile(fileName, data)
        print("✅ Đã lưu diamond: " .. data)
    elseif syn and syn.write_file then
        -- Synapse X support
        syn.write_file(fileName, data)
        print("✅ Đã lưu diamond (Synapse): " .. data)
    else
        print("⚠️ Executor không hỗ trợ writefile")
        print("📝 Copy số này và lưu vào file " .. fileName .. ": " .. data)
    end
end

-- Main function
local function startDiamondMonitor()
    print("🔍 Khởi động Diamond Monitor...")
    print("🏷️ Tool: Shouko.dev Auto Change Account")
    
    local gui = waitForGUI()
    if not gui then
        return
    end
    
    local userId = plr.UserId
    local lastDiamondCount = 0
    local updateInterval = 5 -- Cập nhật mỗi 5 giây
    local lastUpdateTime = 0
    
    print("💎 Diamond Monitor đã khởi động!")
    print("👤 User ID: " .. userId)
    
    -- Theo dõi thay đổi kim cương
    RunService.Heartbeat:Connect(function()
        local currentTime = tick()
        
        if currentTime - lastUpdateTime >= updateInterval then
            local currentDiamonds = getDiamondCount(gui)
            
            if currentDiamonds ~= lastDiamondCount then
                lastDiamondCount = currentDiamonds
                saveDiamondToFile(userId, currentDiamonds)
                print("💎 Kim cương hiện tại: " .. currentDiamonds)
            end
            
            lastUpdateTime = currentTime
        end
    end)
    
    -- Lưu dữ liệu ban đầu
    local initialDiamonds = getDiamondCount(gui)
    saveDiamondToFile(userId, initialDiamonds)
    print("💎 Kim cương ban đầu: " .. initialDiamonds)
end

-- Khởi động monitor
startDiamondMonitor()

-- Command kiểm tra diamond thủ công
game.Players.LocalPlayer.Chatted:Connect(function(msg)
    if msg:lower() == "/checkdiamond" then
        local gui = plr.PlayerGui:FindFirstChild("Interface")
        if gui then
            gui = gui:FindFirstChild("DiamondCount")
            if gui then
                gui = gui:FindFirstChild("Count")
                if gui then
                    local diamonds = getDiamondCount(gui)
                    print("💎 Số kim cương hiện tại: " .. diamonds)
                    saveDiamondToFile(plr.UserId, diamonds)
                end
            end
        end
    end
end)
