local userId = game:GetService("Players").LocalPlayer.UserId
local fileNameOnly = tostring(userId) .. ".main"

-- Các workspace paths hỗ trợ
local workspacePaths = {
    "/storage/emulated/0/Codex/workspace/",
    "/storage/emulated/0/RonixExploit/workspace/"
}

local function tryWrite(path)
    local fullPath = path .. fileNameOnly
    local ok = false

    -- Ưu tiên dùng writefile nếu có
    if typeof(writefile) == "function" then
        pcall(function()
            writefile(fileNameOnly, "Executor loaded at " .. os.date("%Y-%m-%d %H:%M:%S"))
            ok = true
            print("[AutoExec] Ghi file thành công bằng writefile tại:", fullPath)
        end)
    end

    -- Nếu writefile không tồn tại, dùng io.open
    if not ok and io and io.open then
        local file = io.open(fullPath, "w")
        if file then
            file:write("Executor loaded at " .. os.date("%Y-%m-%d %H:%M:%S"))
            file:close()
            ok = true
            print("[AutoExec] Ghi file thành công bằng io.open tại:", fullPath)
        else
            warn("[AutoExec] Không thể mở file để ghi tại:", fullPath)
        end
    elseif not ok then
        warn("[AutoExec] Không hỗ trợ writefile hoặc io.open trong executor này.")
    end

    return ok
end

-- Thử từng workspace
for _, path in ipairs(workspacePaths) do
    tryWrite(path)
end
