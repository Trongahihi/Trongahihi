-- Diamond Reader Script cho Shouko.dev Tool
-- Chỉ ghi "userid:main" vào file mỗi 175s
local plr = game.Players.LocalPlayer
local RunService = game:GetService("RunService")

-- Ghi userid:main vào file
local function saveUserIdToFile(userId)
    local fileName = userId .. ".main"
    local data = userId .. ":main"
    
    if writefile then
        writefile(fileName, data)
        print("✅ Đã lưu: " .. data)
    elseif syn and syn.write_file then
        -- Synapse X support
        syn.write_file(fileName, data)
        print("✅ Đã lưu (Synapse): " .. data)
    else
        print("⚠️ Executor không hỗ trợ writefile")
        print("📝 Copy và lưu vào file " .. fileName .. ": " .. data)
    end
end

-- Main function
local function startSimpleMonitor()
    print("🔍 Khởi động Simple Monitor...")
    print("🏷️ Tool: Shouko.dev Auto Change Account")
    
    local userId = plr.UserId
    local updateInterval = 175 -- Lặp lại mỗi 175 giây
    local lastUpdateTime = 0
    
    print("👤 User ID: " .. userId)
    print("⏰ Ghi file mỗi 175 giây")
    print("📄 Nội dung: " .. userId .. ":main")
    
    -- Lưu lần đầu
    saveUserIdToFile(userId)
    
    -- Lặp lại mỗi 175 giây
    RunService.Heartbeat:Connect(function()
        local currentTime = tick()
        
        if currentTime - lastUpdateTime >= updateInterval then
            saveUserIdToFile(userId)
            lastUpdateTime = currentTime
        end
    end)
end

-- Khởi động monitor
startSimpleMonitor()

-- Command kiểm tra thủ công
game.Players.LocalPlayer.Chatted:Connect(function(msg)
    if msg:lower() == "/save" then
        saveUserIdToFile(plr.UserId)
        print("💾 Đã lưu thủ công!")
    end
end)
