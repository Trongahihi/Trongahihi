-- Shouko.dev Executor Check Script
-- This script creates a file to signal that the executor has loaded successfully

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

-- Get the current player's UserId
local player = Players.LocalPlayer
if not player then
    warn("LocalPlayer not found!")
    return
end

local userId = tostring(player.UserId)

-- List of possible workspace paths where the tool looks for executor files
local workspacePaths = {
    "/storage/emulated/0/Codex/Workspace/",
    "/storage/emulated/0/Codex/workspace/",
    "/storage/emulated/0/RonixExploit/Workspace/",
    "/storage/emulated/0/RonixExploit/workspace/"
}

-- Add clone paths for Codex and RonixExploit (001-020 and VNG variants)
local cloneExecutors = {"Codex", "RonixExploit"}
for _, executor in pairs(cloneExecutors) do
    -- Regular clones
    for i = 1, 20 do
        local cloneNum = string.format("%03d", i)
        table.insert(workspacePaths, "/storage/emulated/0/RobloxClone" .. cloneNum .. "/" .. executor .. "/Workspace/")
        table.insert(workspacePaths, "/storage/emulated/0/RobloxClone" .. cloneNum .. "/" .. executor .. "/workspace/")
    end
    
    -- VNG clones
    for i = 1, 20 do
        local cloneNum = string.format("%03d", i)
        table.insert(workspacePaths, "/storage/emulated/0/RobloxVNGClone" .. cloneNum .. "/" .. executor .. "/Workspace/")
        table.insert(workspacePaths, "/storage/emulated/0/RobloxVNGClone" .. cloneNum .. "/" .. executor .. "/workspace/")
    end
end

-- Function to create the executor check file
local function createExecutorFile()
    local fileName = userId .. ".main"
    local fileContent = "executor_loaded_" .. userId .. "_" .. os.time()
    
    -- Try to write to each possible workspace path
    for _, path in pairs(workspacePaths) do
        local success, result = pcall(function()
            writefile(path .. fileName, fileContent)
        end)
        
        if success then
            print("✅ Executor check file created: " .. path .. fileName)
            break
        end
    end
end

-- Function to continuously maintain the file (in case it gets deleted)
local function maintainExecutorFile()
    while true do
        createExecutorFile()
        wait(10) -- Check every 10 seconds
    end
end

-- Initial file creation
print("🚀 Starting executor check for user: " .. player.Name .. " (ID: " .. userId .. ")")
createExecutorFile()

-- Start maintenance loop
spawn(maintainExecutorFile)

-- Optional: Add a notification to confirm the script is running
if game:GetService("StarterGui") then
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Shouko.dev";
        Text = "Executor check script loaded!";
        Duration = 5;
    })
end

print("✅ Shouko.dev executor check script initialized successfully!")
