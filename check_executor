-- Tự động ghi file báo hiệu executor đang hoạt động
local Players = game:GetService("Players")
local userId = Players.LocalPlayer.UserId
local content = "Executor alive at "
local fileNameOnly = tostring(userId) .. ".main"

-- Các đường dẫn workspace có thể dùng
local workspacePaths = {
    "/storage/emulated/0/Codex/workspace/",
    "/storage/emulated/0/RonixExploit/workspace/"
}

-- Hàm thử ghi file
local function tryWrite(path)
    local fullPath = path .. fileNameOnly
    local success = false

    -- Ưu tiên writefile nếu có
    if typeof(writefile) == "function" then
        local ok, err = pcall(function()
            writefile(fullPath, content .. os.date("%Y-%m-%d %H:%M:%S"))
        end)
        if ok then
            success = true
        else
            warn("[AutoExec] Lỗi ghi file bằng writefile:", err)
        end
    elseif io and io.open then
        local file, err = io.open(fullPath, "w")
        if file then
            file:write(content .. os.date("%Y-%m-%d %H:%M:%S"))
            file:close()
            success = true
        else
            warn("[AutoExec] Lỗi ghi file bằng io.open:", err)
        end
    else
        warn("[AutoExec] Executor không hỗ trợ ghi file.")
    end

    if success then
        print("[AutoExec] Đã ghi file báo hiệu tại:", fullPath)
    end
end

-- Cập nhật file mỗi 5 giây
task.spawn(function()
    while task.wait(5) do
        for _, path in ipairs(workspacePaths) do
            tryWrite(path)
        end
    end
end)
